<p style="color: green"><%= notice %></p>

<%= render @city %>
<%=form_with url: city_path(@city), method: :get do |form|%>
  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title, value: params[:title] %>
  </div>
  <div>
    <%= form.label :secteur_activite, style: "display: block" %>
    <%= form.select :secteur_activite, ["all"]+Secteur.all.collect {|h|[h.name, h.id]}, {selected: params[:secteur_activite]}%>

  </div>
  <div>
    <%= form.submit %>
  </div>


<%end%>

<div class="row row-cols-1 row-cols-md-2 g-4">
<%if @joboffers.length > 0%>
  <%=render collection: @joboffers, as: :j, partial: "joboffers/myjoboffer" %>
<%else%>
<p class="aucuneoffre"> Il n'y a aucune offre à afficher. </p>
<%end%>


</div>


<div>
  <%= link_to "Edit this city", edit_city_path(@city) %> |
  <%= link_to "Back to cities", cities_path %>

  <%= button_to "Destroy this city", @city, method: :delete %>
</div>
