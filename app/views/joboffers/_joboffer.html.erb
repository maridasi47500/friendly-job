<div id="<%= dom_id joboffer %>">
  <p>
    <strong>Référence de l'offre:</strong>
    <%= joboffer.title %>
  </p>
  <p>
    <strong>type de Contrat:</strong>
    <%= joboffer.contract.name %>
  </p>

  <p>
    <strong>Secteur d'activite:</strong>
    <%= joboffer.secteur.name %>
  </p>

  <p>
    <strong>date de publication:</strong>
    <%= l(joboffer.created_at) %>
  </p>
  <p>
    <strong>date de debut:</strong>
    <%= joboffer.mydate != "" ? l(joboffer.mydate) : "dès que possible" %>
  </p>
  <p>
    <strong>lieu de travail:</strong>
    <%= joboffer.city.name %>
  </p>










  <p>
    <strong>Dispo:</strong>
    <%= joboffer.dispo.try(:length).to_i > 0 ? "oui" : "non" %>
  </p>
  <p>
    <strong>salaire:</strong>
    <%= joboffer.salaire %>€ brut
  </p>
<h3>Description du poste</h3>
<%if joboffer.mission.try(:length).to_i > 0%>
  <p>
    <strong>mission:</strong>
    <%= joboffer.mymission.html_safe %>
  </p>
<%end%>
<%if joboffer.competence.try(:length).to_i > 0%>
  <p>
    <strong>competence:</strong>
    <%= joboffer.mycompetence.html_safe %>
  </p>
<%end%>
  <p>
    <strong>durée:</strong>
    <%= joboffer.mylength %>
  </p>
  <p>
    <strong>Statut:</strong>
    <%= joboffer.status %>
  </p>
<%if joboffer.profil.try(:length).to_i > 0%>
  <p>
    <strong>profil:</strong>
    <%= joboffer.myprofil.html_safe %>
  </p>
<%end%>

  <p>
    <strong>Expérience:</strong>
    <%= joboffer.experience %>
  </p>
</div>
