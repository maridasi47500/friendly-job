<div id="<%= dom_id joboffer %>">
  <p>
    <strong>Référence de l'offre:</strong>
    <%= joboffer.title %>
  </p>
  <p>
    <strong>type de Contrat:</strong>
    <%= joboffer.contract.name %>
  </p>

  <p>
    <strong>Secteur d'activite:</strong>
    <%= joboffer.secteur.name %>
  </p>

  <p>
    <strong>date de publication:</strong>
    <%= l(joboffer.created_at) %>
  </p>
  <p>
    <strong>date de debut:</strong>
    <%= joboffer.mydate != "" ? l(joboffer.mydate) : "dès que possible" %>
  </p>
  <p>
    <strong>lieu de travail:</strong>
    <%= joboffer.city.name %>
  </p>





  <p>
    <strong>durée:</strong>
    <%= joboffer.mylength %>
  </p>

  <p>
    <strong>Statut:</strong>
    <%= joboffer.status %>
  </p>

  <p>
    <strong>Expérience:</strong>
    <%= joboffer.experience %>
  </p>

  <p>
    <strong>Dispo:</strong>
    <%= joboffer.dispo ? "oui" : "non" %>
  </p>

</div>
